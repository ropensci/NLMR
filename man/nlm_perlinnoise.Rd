% Generated manually from R/nlm_perlinnoise.R
\name{nlm_perlinnoise}
\alias{nlm_perlinnoise}
\title{nlm_perlinnoise}
\description{Simulates a two-dimensional Perlin-noise neutral landscape model.}
\usage{
nlm_perlinnoise(ncol, nrow, resolution = 1, periods = 4, octaves = 3,
  lacunarity = 2, persistence = 0.5, user_seed = NULL, rescale = TRUE)
}
\arguments{
  \item{ncol}{Number of columns forming the raster.}
  \item{nrow}{Number of rows forming the raster.}
  \item{resolution}{Resolution of the raster.}
  \item{periods}{Number of periods in the first octave.}
  \item{octaves}{Number of noise layers to combine.}
  \item{lacunarity}{Frequency multiplier between octaves.}
  \item{persistence}{Amplitude multiplier between octaves.}
  \item{user_seed}{Set random seed for the simulation.}
  \item{rescale}{If TRUE (default), rescale values to 0--1.}
}
\details{
Perlin noise is generated by summing smooth gradient-noise layers (octaves).
Each successive layer changes spatial frequency by \code{lacunarity} and
amplitude by \code{persistence}.
}
\value{A \code{SpatRaster}.}
\references{
Etherington, T. R. (2022). Perlin noise as a hierarchical neutral landscape
model. Web Ecology, 22, 1--6. DOI: \doi{10.5194/we-22-1-2022}.
}
\examples{
perlin <- nlm_perlinnoise(ncol = 80, nrow = 80, periods = 4)
}
